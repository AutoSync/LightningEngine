{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lightning Engine Editor",
  "version": "0.1.0",
  "identifier": "com.lightningengine.editorui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000"
  },
  "app": {
    "windows": [
      {
        "title": "Lightning Engine Editor",
        "width": 1600,
        "height": 960,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}